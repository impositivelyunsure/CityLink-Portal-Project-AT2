@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>
<p>Welcome, @Context.Session.GetString("Username")!</p>

<hr />

<!-- Tab Content -->
<div class="tab-content" id="adminTabContent">

    <!-- Users Tab -->
    <div class="tab-pane fade show active" id="users" role="tabpanel" aria-labelledby="users-tab">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-people me-2"></i>User Management</h5>
                <small class="text-muted">@Model.Users.Count() total users</small>
            </div>
            <div class="card-body">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.Username</td>
                                <td>@user.Email</td>
                                <td><span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-secondary")">@user.Role</span></td>
                                <td>
                                    <form method="post" asp-action="DeleteUser" asp-route-id="@user.Id" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this user?')">Delete</button>
                                    </form>
                                    @if (user.Role != "Admin")
                                    {
                                        <form method="post" asp-action="PromoteUser" asp-route-id="@user.Id" class="d-inline ms-2">
                                            <button type="submit" class="btn btn-warning btn-sm">Promote to Admin</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Announcements Tab -->
    <div class="tab-pane fade" id="announcements" role="tabpanel" aria-labelledby="announcements-tab">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-megaphone me-2"></i>Announcements</h5>
            </div>
            <div class="card-body">
                <div class="collapse mb-3" id="addAnnouncementForm">
                    <div class="card card-body">
                        <form method="post" asp-action="AddAnnouncement" class="row g-3">
                            <div class="col-md-5">
                                <input type="text" name="title" class="form-control" placeholder="Title" required />
                            </div>
                            <div class="col-md-5">
                                <input type="text" name="content" class="form-control" placeholder="Content" required />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-send"></i> Add
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="list-group">
                    @foreach (var a in Model.Announcements)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-start">
                            <div class="ms-2 me-auto">
                                <div class="fw-bold">@a.Title</div>
                                @a.Content
                                <small class="text-muted d-block mt-1">@a.Date.ToShortDateString()</small>
                            </div>
                            <form method="post" asp-action="DeleteAnnouncement" asp-route-id="@a.Id" class="ms-2">
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this announcement?')">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Bookings Tab -->
    <div class="tab-pane fade" id="bookings" role="tabpanel" aria-labelledby="bookings-tab">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-calendar2-check me-2"></i>Bookings Management</h5>
            </div>
            <div class="card-body">
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Booking pagination" class="mb-3">
                        <ul class="pagination justify-content-center">
                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)&limit=@Model.Limit">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }

                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="?page=@i&limit=@Model.Limit">@i</a>
                                </li>
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)&limit=@Model.Limit">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }

                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Service Type</th>
                            <th>Size</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.Bookings)
                        {
                            <tr>
                                <td><code>@booking.BookingId</code></td>
                                <td><span class="badge bg-info">@booking.Size</span></td>
                                <td>@booking.Date.ToShortDateString()</td>
                                <td>
                                    <form method="post" asp-action="DeleteBooking" asp-route-id="@booking.Id" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this booking?')">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Feedback Tab -->
    <div class="tab-pane fade" id="feedback" role="tabpanel" aria-labelledby="feedback-tab">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-chat-left-text me-2"></i>User Feedback</h5>
            </div>
            <div class="card-body">
                <div class="list-group">
                    @foreach (var f in Model.Feedback)
                    {
                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">@f.Name</h6>
                                <small class="text-muted">@f.DateSubmitted.ToShortDateString()</small>
                            </div>
                            <p class="mb-1">@f.Message</p>
                            @if (!string.IsNullOrEmpty(f.Email))
                            {
                                <small class="text-muted">From: @f.Email</small>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>
