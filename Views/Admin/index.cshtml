@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>
<p>Welcome, @Context.Session.GetString("Username")!</p>

<hr />

<h2>User Management</h2>
<table class="table">
    <thead>
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model.Users)
    {
        <tr>
            <td>@user.Username</td>
            <td>@user.Email</td>
            <td>@user.Role</td>
            <td>
                <form method="post" asp-action="DeleteUser" asp-route-id="@user.Id" class="d-inline">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
                @if (user.Role != "Admin")
                {
                    <form method="post" asp-action="PromoteUser" asp-route-id="@user.Id" class="d-inline">
                        <button type="submit" class="btn btn-warning btn-sm">Promote to Admin</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

<hr />

<h2>Announcements</h2>
<form method="post" asp-action="AddAnnouncement">
    <input type="text" name="title" placeholder="Title" required />
    <textarea name="content" placeholder="Content" required></textarea>
    <button type="submit" class="btn btn-primary">Add</button>
</form>

<ul>
@foreach (var a in Model.Announcements)
{
    <li>
        <strong>@a.Title</strong> - @a.Content
        <form method="post" asp-action="DeleteAnnouncement" asp-route-id="@a.Id" class="d-inline">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
        </form>
    </li>
}
</ul>

<hr />

<h2>Feedback</h2>
<ul>
@foreach (var f in Model.Feedback)
{
    <li>
        <strong>@f.Name</strong>: @f.Message (@f.DateSubmitted.ToShortDateString())
    </li>
}
</ul>
