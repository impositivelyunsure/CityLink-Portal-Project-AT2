@{
    ViewData["Title"] = "Home";
}

<div class="hero">
    <h1>Welcome to the Smart Community Portal</h1>
    <p>Your one-stop hub for community services, announcements, and engagement.</p>
    <a href="/Services/Book" class="btn">Get Started</a>
</div>

<div class="grid">
    <div class="card">
        <h2>Announcements</h2>
        <p>Stay up to date with the latest news from CityLink Initiatives.</p>
        <a href="/Announcements" class="btn">View Announcements</a>
    </div>

    <div class="card">
        <h2>Services</h2>
        <p>Book services like waste management, rates enquiries, and events.</p>
        <a href="/Services/Book" class="btn">Book a Service</a>
    </div>

    <div class="card">
        <h2>Feedback</h2>
        <p>Have your say! Share feedback to help improve our community services.</p>
        <a href="/Feedback" class="btn">Submit Feedback</a>
    </div>

    <div class="card">
        <h2>Profile</h2>
        <p>View and manage your personal information and preferences.</p>
        <a href="/Profile" class="btn">Go to Profile</a>
    </div>
</div>
