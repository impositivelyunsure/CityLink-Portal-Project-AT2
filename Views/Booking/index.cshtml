@{
    ViewData["Title"] = "Book a Service";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Book" method="post" class="card">
    <div>
        <label for="serviceType">Service Type</label>
        <select id="serviceType" name="serviceType">
            <option value="waste">Waste Management</option>
            <option value="event">Event Booking</option>
            <option value="rates">Rates Enquiry</option>
        </select>
    </div>

    <div>
        <label for="date">Preferred Date</label>
        <input type="date" id="date" name="date" />
    </div>

    <div>
        <label for="notes">Additional Notes</label>
        <textarea id="notes" name="notes" rows="4" placeholder="Enter any special instructions or details..."></textarea>
    </div>

    <button type="submit">Submit Booking</button>
</form>
